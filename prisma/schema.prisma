// Unumly.uz — productivity & planning
// Prisma schema (Postgres via Neon)
// Auth: Telegram Mini App + Login Widget (custom JWT cookie, no Auth.js tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── User (Telegram-based) ─────────────────────────

model User {
  // Internal id (used as foreign key everywhere)
  id           String   @id @default(cuid())

  // Telegram identity — the only login method
  telegramId   BigInt   @unique
  username     String?            // @username (may change or be empty)
  firstName    String?
  lastName     String?
  photoUrl     String?            // profile photo from Telegram
  languageCode String?            // 2-letter code

  // Booleans we may use later (notification settings, premium status)
  isPremium    Boolean  @default(false)
  notifyLow    Boolean  @default(false)   // notify even on LOW-priority plans
  notifyMedium Boolean  @default(true)
  notifyHigh   Boolean  @default(true)

  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  plans        Plan[]

  @@index([telegramId])
}

// ───────────────────────── Plans ─────────────────────────

enum PlanScope {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PlanPriority {
  LOW
  MEDIUM
  HIGH
}

model Plan {
  id           String        @id @default(cuid())
  userId       String

  title        String
  notes        String?       @db.Text
  scope        PlanScope
  status       PlanStatus    @default(TODO)
  priority     PlanPriority?

  // Date stored as YYYY-MM-DD string — matches client-side type and
  // avoids timezone ambiguity (we filter by string equality / range).
  scheduledFor String        @db.VarChar(10)

  time         String?       @db.VarChar(5)  // "HH:MM"
  duration     Int?                            // minutes (defaults to 60 visually)

  completedAt  DateTime?
  deletedAt    DateTime?     // soft delete; purged after 30 days
  order        Int           @default(0)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, scheduledFor])
  @@index([userId, status])
  @@index([userId, deletedAt])
}
