// Unumly.uz — productivity & planning
// Prisma schema (Postgres via Neon)
// Auth: Telegram Mini App + Login Widget (custom JWT cookie, no Auth.js tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── User (Telegram-based) ─────────────────────────

model User {
  // Internal id (used as foreign key everywhere)
  id           String   @id @default(cuid())

  // Telegram identity — the only login method
  telegramId   BigInt   @unique
  username     String?            // @username (may change or be empty)
  firstName    String?
  lastName     String?
  photoUrl     String?            // profile photo from Telegram
  languageCode String?            // 2-letter code

  // Phone number (E.164 format, e.g. +998901234567) — shared by user via bot
  // 'Share contact' button; used to send OTP codes for login.
  phone        String?  @unique

  // Booleans we may use later (notification settings, premium status)
  isPremium           Boolean @default(false)
  notifyLow           Boolean @default(true)
  notifyMedium        Boolean @default(true)
  notifyHigh          Boolean @default(true)
  notifyUnprioritized Boolean @default(true)   // tasks without a priority

  // Minutes before a task's scheduled time the bot reminder fires.
  // Default 5; UI exposes 5 / 15 / 30 as quick options.
  notifyLeadMin       Int     @default(5)

  // When set, the next plain-text bot message will be treated as the new
  // name for this QuickList (rather than as a list item). Cleared after
  // the user sends a name or cancels.
  botNamingListId String?

  // Whether the default Reja categories (Ish / O'rganish) have been seeded
  // for this user. Seeded once on first category fetch; lets the user delete
  // the defaults without them being re-created on the next sync.
  categoriesSeeded Boolean @default(false)

  // Same idea for Odat (habit) categories — seeded once so deleting the
  // defaults doesn't bring them back on the next fetch.
  habitCategoriesSeeded Boolean @default(false)

  // Same idea for Moliya (finance) categories — kirim/chiqim default'lari
  // bir marta seed qilinadi.
  financeCategoriesSeeded Boolean @default(false)

  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  plans        Plan[]
  quickLists   QuickList[]
  categories   Category[]
  ideas        Idea[]
  habits          Habit[]
  habitCategories HabitCategory[]
  goals           Goal[]
  financeCategories FinanceCategory[]
  transactions      Transaction[]
  budgets           Budget[]
  financialGoals    FinancialGoal[]
  debts             Debt[]

  @@index([telegramId])
  @@index([phone])
}

// One-time login codes sent via Telegram bot. Generated when the user
// requests OTP on the web; the bot delivers them via DM.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String                          // E.164 format
  codeHash  String                          // SHA-256 of the 6-digit code
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, used, expiresAt])
}

// ───────────────────────── Admin config ─────────────────────────
// Single-row table holding the admin password hash (scrypt).
// On first login, if no row exists, falls back to ADMIN_PASSWORD env.
// After admin changes the password from UI, hash is stored here and used.

model AdminConfig {
  id           Int      @id @default(1)
  passwordHash String   // "salt:hex" (scrypt 64-byte)
  updatedAt    DateTime @updatedAt
}

// ───────────────────────── Plans ─────────────────────────

enum PlanScope {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PlanPriority {
  LOW
  MEDIUM
  HIGH
}

model Plan {
  id           String        @id @default(cuid())
  userId       String

  title        String
  notes        String?       @db.Text
  scope        PlanScope
  status       PlanStatus    @default(TODO)
  priority     PlanPriority?

  // Date stored as YYYY-MM-DD string — matches client-side type and
  // avoids timezone ambiguity (we filter by string equality / range).
  scheduledFor String        @db.VarChar(10)

  time         String?       @db.VarChar(5)  // "HH:MM"
  duration     Int?                            // minutes (defaults to 60 visually)

  // Per-task override: minutes before the scheduled time when the reminder
  // should fire. NULL = fall back to the user's account-level default
  // (User.notifyLeadMin). Allowed values: 5 / 15 / 30.
  notifyLeadMin Int?

  // Precomputed UTC instant when this plan should fire a Telegram reminder.
  // Set when both `scheduledFor` and `time` are present; null otherwise.
  // The cron query filters tasks by `notifyAt` to avoid scanning everything.
  notifyAt     DateTime?

  // Set when the reminder has actually been sent.
  notifiedAt   DateTime?

  completedAt  DateTime?
  deletedAt    DateTime?     // soft delete; purged after 30 days
  order        Int           @default(0)

  // When this plan is a generated occurrence of a recurring Habit, this links
  // back to it. Editing the plan's time/status affects only this day's
  // occurrence — the Habit's recurring schedule is untouched.
  habitId      String?

  // When this plan is the scheduled occurrence of a Goal step (OKR qadami),
  // this links back to it. One-off: a step has at most one occurrence, so the
  // FK is unique. Toggling this plan's status syncs GoalStep.done.
  goalStepId   String?       @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit        Habit?        @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goalStep     GoalStep?     @relation(fields: [goalStepId], references: [id], onDelete: Cascade)
  botMessages  BotMessage[]

  @@unique([habitId, scheduledFor])  // one occurrence per habit per day
  @@index([userId, scope, scheduledFor])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([notifyAt, notifiedAt, status])
}

// ───────────────────────── Odat (Habits) ─────────────────────────
// Recurring habits. Each habit materialises as Plan rows (occurrences) for a
// rolling 1-week window on its scheduled weekdays — so it shows up in
// Bugun/Agenda/Kalendar and reuses all the task machinery (time edit,
// completion, bot reminders). Streaks/stats are computed from those plans.

model HabitCategory {
  id        String   @id @default(cuid())
  userId    String

  label     String
  icon      String   // lucide key (heart/dumbbell/book/...)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Habit {
  id         String   @id @default(cuid())
  userId     String

  title      String
  categoryId String?              // loose ref to HabitCategory (null = uncategorized)
  days       Int[]                // scheduled weekdays, getDay() 0=Sun..6=Sat
  time       String?  @db.VarChar(5)  // "HH:MM" — occurrence time / reminder
  notifyLeadMin Int?
  order      Int      @default(0)
  archivedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans      Plan[]

  @@index([userId])
}

// ───────────────────────── Maqsad (Goals / OKR) ─────────────────────────
// 3 pog'onali tuzilma: Goal (maqsad) → SubGoal (kichik maqsad) → GoalStep
// (qadam). Qadamni istalgan kunga vaqt bilan belgilash mumkin — u Plan
// occurrence sifatida materializatsiya bo'lib Bugun/Agenda/Kalendarda
// ko'rinadi (Plan.goalStepId). Progress qadamlardan hisoblanadi.

enum GoalStatus {
  ACTIVE
  DONE
  ARCHIVED
}

model Goal {
  id         String     @id @default(cuid())
  userId     String

  title      String
  icon       String?    // lucide key (target/rocket/...)
  deadline   String?    @db.VarChar(10)  // YYYY-MM-DD — ixtiyoriy muddat
  status     GoalStatus @default(ACTIVE)
  order      Int        @default(0)
  archivedAt DateTime?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subGoals   SubGoal[]

  @@index([userId])
}

model SubGoal {
  id        String   @id @default(cuid())
  goalId    String

  title     String
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  steps     GoalStep[]

  @@index([goalId])
}

model GoalStep {
  id        String   @id @default(cuid())
  subGoalId String

  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subGoal   SubGoal  @relation(fields: [subGoalId], references: [id], onDelete: Cascade)
  plan      Plan?    // scheduled one-off occurrence (Plan.goalStepId)

  @@index([subGoalId])
}

// Telegram messages we sent for a given plan (reminder + inline buttons).
// Stored so we can edit them when the plan's status changes from the app
// (e.g. user marks DONE on web → remove the "Bajardim" button from the
// chat message and replace it with a "✅ Bajarildi" footer).
model BotMessage {
  id        String   @id @default(cuid())
  planId    String
  chatId    BigInt
  messageId Int
  createdAt DateTime @default(now())

  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, chatId, messageId])
  @@index([planId])
}

// ───────────────────────── Tezkor (Quick lists) ─────────────────────────
// Lightweight grouped lists for shopping / to-pack / quick reminders.
// Items can be created from the web app or by sending plain text to the
// Telegram bot — messages within 3 minutes of each other accumulate into
// the same "open" list; after 3 minutes of silence the cron tick closes
// the list and sends a summary message to the chat.

model QuickList {
  id          String   @id @default(cuid())
  userId      String
  name        String   // default: "Ro'yhat — 23-may 14:30"
  source      String   // "bot" | "app"

  // NULL = list is still accepting new bot items (within the 3-min window).
  // The cron tick sets this when it closes a list and sends the summary.
  closedAt    DateTime?

  // Set when the user marks the entire list as "done" — it disappears
  // from the main Tezkor view and shows up in the Bajarilgan archive.
  completedAt DateTime?

  // Set when the cron tick has sent the summary message. Allows us to
  // edit it later (e.g. when user taps "O'chirish"). Mirrors BotMessage.
  summaryChatId    BigInt?
  summaryMessageId Int?

  // Soft delete — purged after 30 days (mirrors Plan behaviour).
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       QuickListItem[]

  @@index([userId, deletedAt])
  // Used by the cron tick to find stale open lists per user.
  @@index([userId, closedAt, updatedAt])
}

model QuickListItem {
  id        String   @id @default(cuid())
  listId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list      QuickList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

// ───────────────────────── Reja (Ideas & Categories) ─────────────────────────
// The Reja board groups free-form "ideas" into user-defined categories.
// Both are synced per-user so the board is identical across web + mini app.
// Ids are client-generated (matching the offline-first store) so optimistic
// creates and first-login imports stay collision-safe.

model Category {
  id        String   @id @default(cuid())
  userId    String

  label     String
  color     String   // CategoryColor union (olive/emerald/.../gray)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Idea {
  id           String        @id @default(cuid())
  userId       String

  title        String
  notes        String?       @db.Text
  categoryId   String        // references Category.id (loose, like Plan)
  done         Boolean       @default(false)
  order        Int           @default(0)

  // Optional scheduling — when present, the idea is mirrored as a Plan
  // (with the same id) so it also shows up in Bugun/Agenda/Kalendar.
  scheduledFor String?       @db.VarChar(10)  // YYYY-MM-DD
  time         String?       @db.VarChar(5)   // HH:MM
  duration     Int?                            // minutes
  priority     PlanPriority?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Moliya (Finance) ─────────────────────────
// Kirim/chiqim tracking. Pul so'mda butun son sifatida saqlanadi (tiyin
// yo'q), BigInt — yillik yig'indi Int chegarasidan oshmasligi uchun.
// Kategoriyalar Reja/Odat patternini takrorlaydi (label/icon/color/order),
// lekin har biri kirim yoki chiqim turiga bog'langan.

enum TransactionType {
  INCOME
  EXPENSE
}

model FinanceCategory {
  id        String          @id @default(cuid())
  userId    String

  type      TransactionType
  label     String
  icon      String          // lucide key (wallet/utensils/car/...)
  color     String          // CategoryColor union (olive/emerald/.../gray)
  order     Int             @default(0)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId, type])
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String

  type       TransactionType
  amount     BigInt          // so'm (butun son, tiyinsiz)
  categoryId String?         // FinanceCategory.id — null = kategoriyasiz
  note       String?
  // Sana YYYY-MM-DD string — Plan kabi (timezone aniqligi uchun).
  date       String          @db.VarChar(10)

  deletedAt  DateTime?       // soft delete; 30 kundan keyin tozalanadi

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kategoriya o'chsa tranzaksiya saqlanadi, faqat categoryId null bo'ladi.
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([userId, type, date])
}

// Oylik byudjet — chiqim kategoriyasiga limit. Har oy takrorlanadi; joriy oy
// sarfi (Transaction yig'indisi) limitga nisbatan kuzatiladi. Bitta kategoriyaga
// bitta limit. Kategoriya o'chsa limit ham o'chadi (cascade).
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     BigInt   // oylik limit (so'm)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

// Moliyaviy maqsad (yig'im) — biror summaga yig'ish. Yig'ilgan summa hissalar
// orqali oshib boradi; bajarilgan holat hisoblanadi (savedAmount >= target).
// OKR "Maqsad"dan alohida (ular vazifa/qadam asosli, bu — pul asosli).
model FinancialGoal {
  id           String   @id @default(cuid())
  userId       String

  title        String
  icon         String?  // lucide key (ixtiyoriy)
  targetAmount BigInt   // maqsad summa (so'm)
  savedAmount  BigInt   @default(0) // yig'ilgan summa (so'm)
  deadline     String?  @db.VarChar(10) // YYYY-MM-DD — ixtiyoriy muddat
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Qarzdorlik (Debts) ─────────────────────────
// Olingan (BORROWED — men qarzdorman) yoki berilgan (LENT — menga qarzdor)
// qarzlar. Qisman qaytarish paidAmount orqali; to'liq hal qilinsa settledAt.
// dueDate bo'lsa notifyAt hisoblanadi va cron muddatda bot eslatmasi yuboradi
// (Plan reminderlari bilan bir xil mexanizm).

enum DebtType {
  BORROWED // men oldim — qarzdorman
  LENT     // men berdim — menga qarzdor
}

model Debt {
  id           String    @id @default(cuid())
  userId       String

  type         DebtType
  counterparty String    // kim bilan (ism)
  amount       BigInt    // umumiy summa (so'm)
  paidAmount   BigInt    @default(0) // qaytarilgan qism

  dueDate      String?   @db.VarChar(10) // YYYY-MM-DD — ixtiyoriy muddat
  note         String?

  // Bot eslatmasi (Plan kabi) — dueDate bo'yicha hisoblanadi.
  notifyAt     DateTime?
  notifiedAt   DateTime?

  settledAt    DateTime? // to'liq hal qilingan
  order        Int       @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notifyAt, notifiedAt, settledAt])
}
